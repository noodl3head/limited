# Shared backend and assistant settings
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Sarvam STT / TTS
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_TOKEN=your_sarvam_stt_api_key
SARVAM_STT_LANGUAGE=hi-IN
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_SAMPLE_RATE=24000

# Gemini (router + enricher + composer)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_ROUTER_MODEL=gemini-2.0-flash-lite
GEMINI_ENRICHER_MODEL=gemini-2.0-flash
GEMINI_COMPOSER_MODEL=gemini-2.5-flash

# Brave Search
BRAVE_API_KEY=your_brave_search_api_key
BRAVE_SEARCH_COUNT=5

# Backend settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
ASSISTANT_AGENT_NAME=helmet-phone-first-agent

# Shared secret used by the assistant service when calling backend-only endpoints
ASSISTANT_BACKEND_TOKEN=replace_with_a_long_random_value

# Assistant persona
ASSISTANT_NAME=MS Dhoni
INITIAL_GREETING=Haan bolo.
MAX_RESPONSE_SENTENCES=2

# Mobile app setting.
# Expo reads this from helmet_ai/mobile_app/.env, so copy this one line there too.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8080
